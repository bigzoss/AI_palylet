# Backend only. Never put a secret in a VITE_* variable.
AUTH_USERNAME=admin
# Required: set your own login password. Empty passwords disable login.
AUTH_PASSWORD=
AUTH_SESSION_HOURS=12
# Set true when accessed through HTTPS.
AUTH_COOKIE_SECURE=false
OPENAI_API_KEY=
# Native OpenAI: https://api.openai.com/v1
# Also accepts legacy OPENAI_API_BASE. Never place credentials in this URL.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_MODE=auto
# TEACHER_MODEL is accepted as fallback for OPENAI_TEXT_MODEL.
OPENAI_VISION_MODEL=
OPENAI_TEXT_MODEL=
OPENAI_TRANSCRIBE_MODEL=whisper-1
OPENAI_IMAGE_MODEL=
OPENAI_IMAGE_SIZE=auto
OPENAI_TIMEOUT_SECONDS=180
OPENAI_MAX_OUTPUT_TOKENS=16000
# Optional USTC Qwen override. Flash/chat defaults to non-thinking; reasoner keeps thinking.
# OPENAI_ENABLE_THINKING=false
DATA_DIR=data
# Empty DATABASE_URL keeps SQLite. MySQL passwords belong only in ignored local configuration.
DATABASE_URL=
MYSQL_HOST=
MYSQL_PORT=13306
MYSQL_DATABASE=framecraft
MYSQL_USER=framecraft
MYSQL_PASSWORD=
MYSQL_LOCAL_MANAGED=false
DATABASE_POOL_SIZE=5
DATABASE_POOL_RECYCLE=1800
MAX_UPLOAD_MB=200
MAX_DURATION_SECONDS=180
MAX_FRAMES=120
# Optional absolute paths; a bundled FFmpeg is available through imageio-ffmpeg.
FFMPEG_PATH=
FFPROBE_PATH=
